# Environment Configuration
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="Merchant Cash-Flow Decision Intelligence"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration (SQLite by default for zero-setup local run; or PostgreSQL)
DATABASE_URL=sqlite:///./cashflow.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/merchant_cashflow

# Dynamic Buffer & Risk Engine Parameters
DEFAULT_LOOKAHEAD_DAYS=30
MIN_HISTORY_DAYS_FOR_DECISION=14
UNCERTAINTY_COVERAGE=0.85
CONFIDENCE_THRESHOLD_CAUTION=0.60
CONFIDENCE_THRESHOLD_SAFE=0.75
ASYMMETRIC_LOSS_PENALTY=10.0

# Optional Grounded LLM Provider (Fallback deterministic template used if empty)
# LLM_PROVIDER=gemini # options: 'gemini', 'openai', 'none'
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=none
